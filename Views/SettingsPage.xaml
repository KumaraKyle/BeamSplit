<UserControl x:Class="BeamSplit.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Settings"/>
          <TextBlock Style="{StaticResource Sub}" Text="Where things live and how sessions behave."/>

          <TextBlock Style="{StaticResource Lbl}" Text="BEAMNG INSTALL"/>
          <Grid Margin="0,0,0,4">
            <ComboBox x:Name="CbGameRoot" Margin="0,0,180,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnRescanGames" Style="{StaticResource Small}" Content="Rescan" Margin="0,0,6,0"/>
              <Button x:Name="BtnBrowseGame" Style="{StaticResource Small}" Content="Browse"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="LblGameHint" Style="{StaticResource Sub}"/>

          <TextBlock Style="{StaticResource Lbl}" Text="INSTANCES FOLDER"/>
          <Grid Margin="0,0,0,4">
            <TextBox x:Name="TxtInstances" Margin="0,0,96,0"/>
            <Button x:Name="BtnBrowseInstances" Style="{StaticResource Small}" Content="Browse"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>
          <TextBlock x:Name="LblInstHint" Style="{StaticResource Sub}"/>

          <TextBlock Style="{StaticResource Lbl}" Text="BEAMMP LAUNCHER"/>
          <TextBox x:Name="TxtLauncher"/>

          <TextBlock Style="{StaticResource Lbl}" Text="BEAMMP SERVER FOLDER"/>
          <TextBox x:Name="TxtServerDir"/>

          <TextBlock Style="{StaticResource Lbl}" Text="BEAMMP CLIENT ZIP"/>
          <TextBox x:Name="TxtModZip"/>

          <TextBlock Style="{StaticResource Lbl}" Text="BASE PORT (instance N uses base + N*2)"/>
          <TextBox x:Name="TxtBasePort" Width="120" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Audio for every instance" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource Sub}"
                     Text="Applied to every BeamNG profile before launch. Windows Volume Mixer can still mute or reroute each running process separately."/>

          <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Lbl}" Text="MASTER %"/>
              <TextBox x:Name="TxtAudioMaster"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Lbl}" Text="VEHICLE / EFFECTS %"/>
              <TextBox x:Name="TxtAudioEffects"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource Lbl}" Text="MUSIC %"/>
              <TextBox x:Name="TxtAudioMusic"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Style="{StaticResource Lbl}" Text="UI %"/>
              <TextBox x:Name="TxtAudioUi"/>
            </StackPanel>
          </Grid>

          <TextBlock Style="{StaticResource Lbl}" Text="OUTPUT DEVICE"/>
          <Grid Margin="0,0,0,4">
            <ComboBox x:Name="CbAudioDevice" IsEditable="True" Margin="0,0,96,0"/>
            <Button x:Name="BtnRefreshAudio" Style="{StaticResource Small}" Content="Refresh"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>
          <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,8"
                     Text="System default is recommended. Device changes take effect on the next launch."/>
          <TextBlock Style="{StaticResource Lbl}" Text="BEAMMP MIX"/>
          <ComboBox x:Name="CbAudioMix" Width="430" HorizontalAlignment="Left">
            <ComboBoxItem Content="Local vehicle per player - no doubled cars (recommended)"/>
            <ComboBoxItem Content="Every instance - full world mix (separate headsets)"/>
            <ComboBoxItem Content="P0 only - single shared listener"/>
          </ComboBox>
          <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,8"
                     Text="Local vehicle mode keeps each player's own car and perspective audio, but suppresses BeamMP remote vehicle emitters in that process."/>
          <CheckBox x:Name="ChkAudioBackground" Content="Keep sound playing when BeamNG windows are not focused"/>
          <CheckBox x:Name="ChkAudioHeadphones" Content="Stereo headphones mode (HRTF)"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Session behaviour" Margin="0,0,0,12"/>
          <CheckBox x:Name="ChkBorderless" Content="Borderless windows"/>
          <CheckBox x:Name="ChkIsolate" Content="One controller per instance"/>
          <CheckBox x:Name="ChkProtoInput" Content="Proto Input (recommended: focus-independent controller routing)"/>
          <CheckBox x:Name="ChkWatchdog" Content="Legacy focus guard fallback"/>
          <CheckBox x:Name="ChkLaunchCinematic" Content="Play the BeamSplit launch film while instances launch"/>
          <CheckBox x:Name="ChkAutoJoinBeamMp" Content="Automatically guest-login and join the local BeamMP server"/>
          <Button x:Name="BtnPreviewCinematic" Style="{StaticResource Small}" Content="Preview launch film"
                  HorizontalAlignment="Left" Margin="20,0,0,6"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Frame limit for every instance" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtFrameLimit" Width="70"/>
          </StackPanel>
          <ComboBox x:Name="CbMode" Width="240" HorizontalAlignment="Left" Margin="0,10,0,0">
            <ComboBoxItem Content="BeamMP - shared world"/>
            <ComboBoxItem Content="Solo - separate worlds"/>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Graphics applied to every instance" Margin="0,0,0,12"/>
          <CheckBox x:Name="ChkLowMemoryGfx" Content="Low-memory mode · quarter textures and minimum world detail"/>
          <TextBlock Style="{StaticResource Sub}" Margin="24,0,0,8"
                     Text="Recommended for Italy/Utah with multiple players. Disables reflections, mirrors, grass, clouds and post-processing."/>
          <CheckBox x:Name="ChkApplyGfx" Content="Apply these on launch"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Lbl}" Text="ANISOTROPIC"/>
              <ComboBox x:Name="CbAniso">
                <ComboBoxItem Content="Off"/><ComboBoxItem Content="2x"/><ComboBoxItem Content="4x"/>
                <ComboBoxItem Content="8x"/><ComboBoxItem Content="16x"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Lbl}" Text="ANTI-ALIASING"/>
              <ComboBox x:Name="CbAA">
                <ComboBoxItem Content="Off"/><ComboBoxItem Content="FXAA"/>
                <ComboBoxItem Content="2x MSAA"/><ComboBoxItem Content="4x MSAA"/>
              </ComboBox>
            </StackPanel>
          </Grid>
          <CheckBox x:Name="ChkNoShadows" Content="Disable shadows (biggest win with several instances)"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Steam API emulation (Goldberg)" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource Sub}"
                     Text="Optional. One Steam client serves one session, so several copies of the same Steam game can fight over it - the second instance bounces back to Steam, or they share one set of cloud saves. Emulating the Steam API inside each instance lets them start independently and offline."/>

          <Border Background="#2A1E14" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                  CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Read this first" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="0,0,0,6"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"
                         Text="- Use it only to run extra instances of a game you actually own. It is not a way to play games you haven't bought."/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"
                         Text="- BeamSplit does not ship or download Goldberg. Point it at a copy you already have."/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"
                         Text="- Only BeamSplit's instance copies are modified. Your real game install is never touched, and the original steam_api64.dll is backed up so it can be restored."/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                         Text="- Steam features (achievements, cloud saves, friends, workshop) stop working in those instances. Anti-cheat and online services may refuse to run. BeamMP's own login is separate and unaffected."/>
            </StackPanel>
          </Border>

          <CheckBox x:Name="ChkSteamEmu" Content="Use Steam API emulation for instances"/>
          <TextBlock Style="{StaticResource Lbl}" Text="GOLDBERG FOLDER (must contain steam_api64.dll)"/>
          <Grid Margin="0,0,0,4">
            <TextBox x:Name="TxtSteamEmu" Margin="0,0,180,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnFindEmu" Style="{StaticResource Small}" Content="Locate" Margin="0,0,6,0"/>
              <Button x:Name="BtnBrowseEmu" Style="{StaticResource Small}" Content="Browse"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="LblEmuState" Style="{StaticResource Sub}"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,-8,0,10"
                     Text="BeamSplit will not fetch this for you - there is no canonical release of Goldberg any more, and unsigned Steam emulators from random mirrors are a common malware vector. Supply your own copy and use Browse. Locate also checks whether Nucleus Co-op has already installed one on this PC."/>
          <Button x:Name="BtnRestoreEmu" Style="{StaticResource Small}" Content="Restore original steam_api64.dll"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="BeamSplit updates" Margin="0,0,0,6"/>
              <TextBlock x:Name="LblCurrentVersion" Style="{StaticResource Sub}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Pill}" Background="#253828" VerticalAlignment="Top">
              <TextBlock Text="VERIFIED DOWNLOADS" Foreground="{StaticResource Good}" FontSize="10" FontWeight="Bold"/>
            </Border>
          </Grid>
          <TextBlock x:Name="LblUpdateStatus" Margin="0,12,0,8" TextWrapping="Wrap"/>
          <ProgressBar x:Name="UpdateProgress" Style="{StaticResource GlowProgress}" Height="8" Value="0" Margin="0,0,0,12"/>
          <CheckBox x:Name="ChkAutoUpdates" Content="Check for updates quietly when BeamSplit starts"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                     Text="Updates come from the official KumaraKyle/BeamSplit GitHub release and are installed only when GitHub's SHA-256 digest matches the download. Your config and instance folders stay where they are."/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnCheckUpdate" Style="{StaticResource Small}" Content="Check now" Margin="0,0,8,0"/>
            <Button x:Name="BtnInstallUpdate" Style="{StaticResource Primary}" Content="Download and restart" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnOpenRelease" Style="{StaticResource Small}" Content="Release notes" IsEnabled="False"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Maintenance" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnSave" Style="{StaticResource Primary}" Content="Save" Margin="0,0,10,0"/>
            <Button x:Name="BtnRebuild" Content="Rebuild instances" Margin="0,0,10,0"/>
            <Button x:Name="BtnResetProfiles" Content="Reset profiles" Margin="0,0,10,0"/>
            <Button x:Name="BtnOpenData" Content="Open data folder"/>
          </StackPanel>
          <TextBlock x:Name="LblMaint" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
