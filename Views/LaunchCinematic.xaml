<UserControl x:Class="BeamSplit.Views.LaunchCinematic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True">
  <Grid Background="#05080F" ClipToBounds="True">
    <Image x:Name="CinematicFrame" Stretch="Fill" SnapsToDevicePixels="True"/>
    <Button x:Name="BtnSkip" Content="SKIP  ·  ESC" Style="{StaticResource Small}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,32,0"
            Background="#8C0B0D12" BorderBrush="#4CFF7A2F" Foreground="{StaticResource Muted}"/>
  </Grid>
</UserControl>
