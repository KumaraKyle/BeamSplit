<Window x:Class="BeamSplit.Views.MemoryAdviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamSplit memory check" Width="530" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Warn}"
          BorderThickness="1" CornerRadius="12" Padding="24">
    <StackPanel>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="21" Background="#3A2B13" VerticalAlignment="Top">
          <TextBlock Text="!" Foreground="{StaticResource Warn}" FontWeight="Black" FontSize="25"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="This map may run out of memory" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="LblHeadline" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <Border Background="{StaticResource BgAlt}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock x:Name="LblMemory" FontFamily="Consolas" FontSize="13"/>
          <TextBlock x:Name="LblReason" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Low-memory mode uses quarter-resolution textures and disables expensive world effects. You can turn it off again from Play or Settings."
                 TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BtnContinue" Content="Keep current settings" Style="{StaticResource Small}"
                VerticalAlignment="Center"/>
        <Button x:Name="BtnEnable" Grid.Column="1" Content="Switch to low-memory settings"
                Style="{StaticResource Primary}" Padding="18,10" Margin="10,0,0,0"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
