<UserControl x:Class="BeamSplit.Views.AppTourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True">
  <Grid Background="#5C05070A">
    <Border BorderBrush="#66FF7A2F" BorderThickness="2" CornerRadius="14" Margin="224,18,18,54" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect Color="#FF7A2F" BlurRadius="24" ShadowDepth="0" Opacity="0.32"/></Border.Effect>
    </Border>

    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,27,0,0" Background="#E8171B23"
            BorderBrush="#525B69" BorderThickness="1" CornerRadius="18" Padding="15,7">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="COCKPIT TOUR" FontSize="10" FontWeight="Bold" Foreground="#CDD3DD"/>
        <TextBlock x:Name="LblTourCount" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>

    <Border x:Name="TourCard" Width="510" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,78"
            Background="#F2171B23" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="14" Padding="22"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Border Background="#3E241A" CornerRadius="8" Padding="9,5" HorizontalAlignment="Left">
            <TextBlock x:Name="LblTourEyebrow" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
          </Border>
          <Button x:Name="BtnTourClose" Style="{StaticResource Small}" Content="Close ×" HorizontalAlignment="Right" Background="Transparent"/>
        </Grid>
        <TextBlock x:Name="LblTourTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="LblTourBody" Foreground="#B1B9C8" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <Border Background="#212731" CornerRadius="8" Padding="11,8" Margin="0,0,0,15">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="PRO TIP" Foreground="{StaticResource Warn}" FontWeight="Bold" FontSize="9" Margin="0,1,9,0"/>
            <TextBlock x:Name="LblTourTip" Foreground="#9EA8B8" FontSize="11" TextWrapping="Wrap" MaxWidth="365"/>
          </StackPanel>
        </Border>
        <ProgressBar x:Name="TourProgress" Style="{StaticResource GlowProgress}" Height="6" Margin="0,0,0,16"/>
        <Grid>
          <Button x:Name="BtnTourBack" Content="‹ Back" HorizontalAlignment="Left"/>
          <Button x:Name="BtnTourNext" Style="{StaticResource Primary}" Content="Next ›" HorizontalAlignment="Right"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
