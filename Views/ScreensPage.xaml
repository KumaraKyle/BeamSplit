<UserControl x:Class="BeamSplit.Views.ScreensPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource H1}" Text="Screens"/>
      <TextBlock Style="{StaticResource Sub}"
                 Text="Drag a controller onto a screen to make it a player. Split a screen to fit more than one. Changes apply to a running session within a second."/>
    </StackPanel>

    <!-- device tray -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <TextBlock Style="{StaticResource Lbl}" Text="CONTROLLERS" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnIdentify" Style="{StaticResource Small}" Content="Identify" Margin="0,0,6,0"
                    ToolTip="press a button on a pad and it will flash here"/>
            <Button x:Name="BtnRescan" Style="{StaticResource Small}" Content="Rescan"/>
          </StackPanel>
        </Grid>
        <WrapPanel x:Name="Tray"/>
        <TextBlock x:Name="LblTrayHint" Style="{StaticResource Sub}" Margin="0,10,0,0"
                   Text="Drag a chip onto a screen below. Drag it off again to unassign."/>
      </StackPanel>
    </Border>

    <!-- monitor map -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
      <Grid>
        <Canvas x:Name="Map" ClipToBounds="False" Background="Transparent"/>
        <TextBlock x:Name="LblNoMonitors" Text="No displays detected." Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal">
      <Button x:Name="BtnLaunch" Style="{StaticResource Primary}" Content="Launch session" Margin="0,0,10,0"/>
      <Button x:Name="BtnApply" Content="Apply to running session" Margin="0,0,10,0"/>
      <Button x:Name="BtnClear" Content="Clear all"/>
      <TextBlock x:Name="LblSummary" VerticalAlignment="Center" Margin="16,0,0,0"
                 FontSize="12" Foreground="{StaticResource Muted}"/>
    </StackPanel>
  </Grid>
</UserControl>
