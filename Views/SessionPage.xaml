<UserControl x:Class="BeamSplit.Views.SessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Launch dashboard"/>
              <TextBlock Style="{StaticResource Sub}" Text="One place for every instance, launcher, mod, port and system resource."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button x:Name="BtnLaunch" Style="{StaticResource Primary}" Content="Launch" Margin="0,0,8,0"/>
              <Button x:Name="BtnRetile" Style="{StaticResource Small}" Content="Re-tile" Margin="0,0,8,0"/>
              <Button x:Name="BtnStop" Style="{StaticResource Small}" Content="Stop all"/>
            </StackPanel>
          </Grid>

          <!-- machine + aggregate live stats -->
          <UniformGrid Columns="4" Margin="0,4,0,12">
            <Border Background="#10131A" CornerRadius="9" Padding="12" Margin="0,0,7,0"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="CPU"/>
                <TextBlock x:Name="LblCpuLive" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="LblCpuSpec" FontSize="10.5" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#10131A" CornerRadius="9" Padding="12" Margin="0,0,7,0"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="MEMORY"/>
                <TextBlock x:Name="LblMemoryLive" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="LblMemorySpec" FontSize="10.5" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#10131A" CornerRadius="9" Padding="12" Margin="0,0,7,0"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="GRAPHICS"/>
                <TextBlock x:Name="LblGpuLive" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblGpuSpec" FontSize="10.5" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#10131A" CornerRadius="9" Padding="12"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="SESSION"/>
                <TextBlock x:Name="LblSessionLive" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Good}"/>
                <TextBlock x:Name="LblSessionSpec" FontSize="10.5" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- server -->
          <Border Background="#10131A" CornerRadius="10" Padding="14" Margin="0,6,0,0"
                  BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DotServer" Grid.Column="0" Width="10" Height="10" Margin="0,5,12,0"
                       VerticalAlignment="Top" Fill="{StaticResource Faint}"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="LblServerTitle" Style="{StaticResource H2}" Text="BeamMP server"/>
                <TextBlock x:Name="LblServerDetail" FontSize="11.5" Foreground="{StaticResource Muted}"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                <ItemsControl x:Name="PlayerList" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnServerToggle" Style="{StaticResource Small}" Content="Start" Margin="0,0,6,0"/>
                <Button x:Name="BtnServerLog" Style="{StaticResource Small}" Content="Log"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="Cards"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
