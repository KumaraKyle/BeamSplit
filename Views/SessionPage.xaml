<UserControl x:Class="BeamSplit.Views.SessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BeamSplit.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Launch dashboard"/>
              <TextBlock Style="{StaticResource Sub}" Text="One place for every instance, launcher, mod, port and system resource."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button x:Name="BtnLaunch" Style="{StaticResource Primary}" Content="Launch" Margin="0,0,8,0"/>
              <Button x:Name="BtnRetile" Style="{StaticResource Small}" Content="Re-tile" Margin="0,0,8,0"/>
              <Button x:Name="BtnStopSession" Style="{StaticResource Small}" Content="Stop session" Margin="0,0,8,0"
                      ToolTip="Stop every BeamNG instance and launcher, but leave the local BeamMP server running."/>
              <Button x:Name="BtnStopAll" Style="{StaticResource Small}" Content="Stop all"
                      ToolTip="Stop every BeamNG instance, launcher, and the local BeamMP server."/>
            </StackPanel>
          </Grid>

          <!-- live cockpit: vector gauges stay crisp and redraw from SessionMonitor -->
          <Border CornerRadius="15" BorderBrush="#3E4654" BorderThickness="1" Margin="0,4,0,12" Padding="18,12,18,14">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#161B23" Offset="0"/><GradientStop Color="#080A0F" Offset="0.55"/>
                <GradientStop Color="#11151C" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <TextBlock Text="B E A M S P L I T   T E L E M E T R Y" FontSize="10" FontWeight="Bold" Foreground="#A7AFBE"/>
                <TextBlock x:Name="LblDashClock" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource Accent}" FontSize="12"/>
              </Grid>
              <Grid Grid.Row="1" Margin="0,5,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <UniformGrid Grid.Column="0" Columns="2">
                  <local:DashGauge x:Name="GaugeCpu" Height="178" Label="SYSTEM LOAD" Accent="{StaticResource Accent}"/>
                  <local:DashGauge x:Name="GaugeRam" Height="178" Label="SYSTEM RAM" Accent="#51D6E8"/>
                </UniformGrid>
                <Grid Grid.Column="1" Margin="14,18,0,18">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Border Style="{StaticResource SoftCard}" Background="#11161E" Margin="0">
                    <Grid>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RUNNING INSTANCES" Style="{StaticResource Lbl}"/>
                        <TextBlock x:Name="LblInstancesValue" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Good}"/>
                        <TextBlock x:Name="LblInstancesDetail" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Grid.Row="2" Style="{StaticResource SoftCard}" Background="#11161E" Margin="0">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="WORLD SYNC" Style="{StaticResource Lbl}"/>
                      <TextBlock x:Name="LblSyncValue" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" Foreground="#E8B339"/>
                      <TextBlock x:Name="LblSyncDetail" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Row="2" Margin="8,2,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,16,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock x:Name="LblMachineStrip" Grid.Row="0" FontSize="10.5" Foreground="{StaticResource Muted}"
                             TextTrimming="CharacterEllipsis" LineHeight="15"/>
                  <TextBlock x:Name="LblDisplayStrip" Grid.Row="1" FontSize="10.5" Foreground="{StaticResource Muted}"
                             TextTrimming="CharacterEllipsis" LineHeight="15" Margin="0,3,0,0"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Border x:Name="LampServer" Style="{StaticResource Pill}" Background="#282D36" Margin="0"><TextBlock Text="SERVER" FontSize="9" FontWeight="Bold"/></Border>
                  <Border x:Name="LampInput" Style="{StaticResource Pill}" Background="#282D36" Margin="6,0,0,0"><TextBlock Text="INPUT" FontSize="9" FontWeight="Bold"/></Border>
                  <Border x:Name="LampWindows" Style="{StaticResource Pill}" Background="#282D36" Margin="6,0,0,0"><TextBlock Text="WINDOWS" FontSize="9" FontWeight="Bold"/></Border>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <!-- server -->
          <Border Background="#10131A" CornerRadius="10" Padding="14" Margin="0,6,0,0"
                  BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DotServer" Grid.Column="0" Width="10" Height="10" Margin="0,5,12,0"
                       VerticalAlignment="Top" Fill="{StaticResource Faint}"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="LblServerTitle" Style="{StaticResource H2}" Text="BeamMP server"/>
                <TextBlock x:Name="LblServerDetail" FontSize="11.5" Foreground="{StaticResource Muted}"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                <ItemsControl x:Name="PlayerList" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnServerToggle" Style="{StaticResource Small}" Content="Start" Margin="0,0,6,0"/>
                <Button x:Name="BtnServerLog" Style="{StaticResource Small}" Content="Log"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="Cards"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
