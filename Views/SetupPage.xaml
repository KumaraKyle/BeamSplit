<UserControl x:Class="BeamSplit.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#10131A" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
      <Grid>
        <StackPanel>
          <TextBlock Text="Setup" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="Install, repair, and verify everything BeamSplit needs before race day."
                     Foreground="{StaticResource Muted}" FontSize="11.5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnStatusView" Content="System status" Style="{StaticResource Small}" Margin="0,0,8,0"/>
          <Button x:Name="BtnGuideView" Content="First-time guide" Style="{StaticResource Small}"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="ReadinessView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="System readiness"/>
              <TextBlock x:Name="LblSetupHint" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
              <ProgressBar x:Name="SetupProgress" Style="{StaticResource GlowProgress}" Height="9" Margin="0,6,22,7"/>
              <TextBlock x:Name="LblSetupReadiness" Foreground="{StaticResource Muted}" FontSize="11.5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
              <TextBlock x:Name="LblSetupPercent" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"
                         FontSize="32" FontWeight="SemiBold"/>
              <Button x:Name="BtnGoPlay" Style="{StaticResource Primary}" Content="Go to Play" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Detailed setup status"/>
                <TextBlock Style="{StaticResource Sub}"
                           Text="Green is ready. Red blocks launch. Amber is optional but recommended."/>
              </StackPanel>
              <TextBlock x:Name="LblSummary" HorizontalAlignment="Right" VerticalAlignment="Top"
                         FontSize="12" Foreground="{StaticResource Muted}"/>
            </Grid>
            <ItemsControl x:Name="Items"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnFixAll" Style="{StaticResource Primary}" Content="Fix everything it can" Margin="0,0,10,0"/>
              <Button x:Name="BtnRecheck" Content="Re-check" Margin="0,0,10,0"/>
              <Button x:Name="BtnOpenData" Content="Open data folder"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Setup log" Margin="0,0,0,10"/>
            <Border Background="#0B0D12" CornerRadius="8" Padding="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <ScrollViewer x:Name="LogScroll" Height="170" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ContentControl x:Name="GuideHost" Grid.Row="1" Visibility="Collapsed"/>
  </Grid>
</UserControl>
