<UserControl x:Class="BeamSplit.Views.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="0" ClipToBounds="True">
        <Grid>
          <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#241B17" Offset="0"/><GradientStop Color="#171A21" Offset="0.58"/><GradientStop Color="#151B25" Offset="1"/>
            </LinearGradientBrush>
          </Grid.Background>
          <Ellipse Width="280" Height="280" Fill="#18FF7A2F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-145,-65,0">
            <Ellipse.Effect><BlurEffect Radius="30"/></Ellipse.Effect>
          </Ellipse>
          <Grid Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel>
              <WrapPanel>
                <Border Style="{StaticResource Pill}" Background="#40261B"><TextBlock Text="RACE CONTROL" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/></Border>
                <Border Style="{StaticResource Pill}"><TextBlock x:Name="LblModePill" FontSize="11"/></Border>
                <Border Style="{StaticResource Pill}"><TextBlock x:Name="LblRigPill" FontSize="11"/></Border>
              </WrapPanel>
              <TextBlock Text="Build the session. Launch the whole rig." FontSize="25" FontWeight="SemiBold" Margin="0,8,0,5"/>
              <TextBlock x:Name="LblLaunchHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <ProgressBar x:Name="ReadinessProgress" Style="{StaticResource GlowProgress}" Height="9" Margin="0,0,0,8"/>
              <TextBlock x:Name="LblReadiness" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnLaunch" Style="{StaticResource Primary}" Content="Launch session" Margin="0,0,10,0"/>
                <Button x:Name="BtnOpenSetup" Content="Review setup"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource SoftCard}" Background="#CC11151C">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="READY" Style="{StaticResource Lbl}"/>
                <TextBlock x:Name="LblPercent" Foreground="{StaticResource Accent}" FontSize="38" FontWeight="SemiBold"/>
                <TextBlock x:Name="LblLaunchSummary" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Players and world"/>
            <TextBlock Style="{StaticResource Sub}" Text="The essentials for this launch."/>
            <TextBlock Style="{StaticResource Lbl}" Text="SESSION ENGINE"/>
            <ComboBox x:Name="CbEngine">
              <ComboBoxItem Content="Multi-instance · stable"/>
              <ComboBoxItem Content="Single instance · experimental · 2 players"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Lbl}" Text="SESSION MODE"/>
            <ComboBox x:Name="CbMode">
              <ComboBoxItem Content="BeamMP · shared world"/><ComboBoxItem Content="Solo · separate worlds"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Lbl}" Text="PLAYERS"/>
            <ComboBox x:Name="CbPlayers">
              <ComboBoxItem Content="1 player"/><ComboBoxItem Content="2 players"/>
              <ComboBoxItem Content="3 players"/><ComboBoxItem Content="4 players"/>
            </ComboBox>
            <TextBlock x:Name="LblControllers" Style="{StaticResource Sub}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            <Button x:Name="BtnConfigureControllers"
                    Content="Configure controllers"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    ToolTip="Assign controllers or keyboard input to each player on the Screens page"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Screen preset"/>
            <TextBlock Style="{StaticResource Sub}" Text="Choose a fast layout here, or fine-tune it on Screens."/>
            <TextBlock Style="{StaticResource Lbl}" Text="LAYOUT"/>
            <ComboBox x:Name="CbPreset">
              <ComboBoxItem Content="Automatic · one player per display first"/>
              <ComboBoxItem Content="Primary display · stacked"/>
              <ComboBoxItem Content="Primary display · side by side"/>
              <ComboBoxItem Content="Primary display · four-grid"/>
            </ComboBox>
            <TextBlock x:Name="LblLayout" Style="{StaticResource Sub}" Margin="0,5,0,9" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnApplyPreset" Style="{StaticResource Primary}" Content="Apply preset" Margin="0,0,8,0"/>
              <Button x:Name="BtnOpenScreens" Content="Fine-tune screens"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="MapCard" Style="{StaticResource CardStyle}">
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="BeamMP map"/>
              <TextBlock Style="{StaticResource Sub}"
                         Text="Choose from the maps installed with BeamNG. Preview artwork is read directly from the game without extracting it."/>
            </StackPanel>
            <Button x:Name="BtnSwitchMap" Style="{StaticResource Primary}"
                    Content="Switch map · keep games open" HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>
          <TextBlock x:Name="LblMapStatus" Foreground="{StaticResource Muted}" FontSize="11.5"
                     Text="Reading installed maps…" Margin="0,0,0,9" TextWrapping="Wrap"/>
          <Border Background="#0D1118" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="BtnMapPrevious" Grid.Column="0" Content="‹" FontSize="25" Padding="0"
                      ToolTip="Previous maps" BorderThickness="0,0,1,0"/>
              <ScrollViewer x:Name="MapScroller" Grid.Column="1"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                            PanningMode="HorizontalOnly" CanContentScroll="False" Padding="8">
                <ItemsControl x:Name="MapList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="BtnMapNext" Grid.Column="2" Content="›" FontSize="25" Padding="0"
                      ToolTip="More maps" BorderThickness="1,0,0,0"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Launch options"/>
          <TextBlock Style="{StaticResource Sub}" Text="Common session settings, saved immediately and applied to the selected engine."/>
          <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <CheckBox x:Name="ChkBorderless" Content="Borderless tiled windows"/>
              <CheckBox x:Name="ChkIsolate" Content="One controller per instance"/>
              <CheckBox x:Name="ChkProtoInput" Content="Focus-independent Proto Input routing"/>
              <CheckBox x:Name="ChkPlayerMods" Content="Mount my shared mod library"/>
              <CheckBox x:Name="ChkLowMemory" Content="Low-memory graphics · Italy/Utah"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <CheckBox x:Name="ChkCinematic" Content="Play launch cinematic"/>
              <CheckBox x:Name="ChkAutoJoin" Content="Auto guest-login and direct connect"/>
              <CheckBox x:Name="ChkAudioBackground" Content="Keep audio active in the background"/>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                <TextBlock Text="Frame limit per instance" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFrameLimit" Grid.Column="1" Margin="8,0,0,0"/>
              </Grid>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Lbl}" Text="BEAMMP AUDIO MIX" Margin="0,10,0,0"/>
          <ComboBox x:Name="CbAudioMix" Width="470" HorizontalAlignment="Left">
            <ComboBoxItem Content="Local vehicle per player · recommended for shared speakers"/>
            <ComboBoxItem Content="Full world in every instance · separate headsets"/>
            <ComboBoxItem Content="Player 1 only · one shared listener"/>
          </ComboBox>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
